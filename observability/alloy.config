// Alloy：从 Docker 读取 InferGate 应用容器的日志，推送给 Loki。
// gateway 本身不知道 Alloy 存在，它只往 stderr 写；Docker 保存这些输出，Alloy 通过 Docker API 读取。

// 1. 发现容器：只要 infergate-app 这个 compose 项目里的容器（gateway、backend-a、backend-b）
discovery.docker "app" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=infergate-app"]
  }
  // 默认只列出运行中的容器。容器一停，它的 target 就消失，loki.source.docker 会删掉
  // 它的读取位置；再启动时从位置 0 开始，把全部历史日志重发一遍（Loki 以
  // too_far_behind 拒收，dropped_entries 出现一次性台阶）。把已停止的容器也列出来，
  // target 就一直在，容器重启后从内存里记着的位置继续读。
  filter {
    name   = "status"
    values = ["created", "running", "restarting", "paused", "exited"]
  }
}

// 1b. 去掉随运行状态变化的标签。读取位置按"容器 ID + 整组 target 标签"保存，
//     容器停止后 IP、端口、__address__ 会变（IP 变空，端口消失），标签一变就被当成
//     新 target，同样会从头重读。只留下稳定的容器 ID、名字和 compose 标签。
discovery.relabel "stable" {
  targets = discovery.docker.app.targets

  rule {
    action = "labeldrop"
    regex  = "__address__|__meta_docker_network_ip|__meta_docker_port_.*"
  }
}

// 2. 只保留低基数的标签：service 名和输出流。不要把 trace_id、outcome 之类做成标签，
//    它们留在日志正文里，查询时用 LogQL 的 | json 解析。
discovery.relabel "app" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

// 3. 读取日志。时间戳用 Docker 记录的时间，所以完成记录里没有时间字段也没关系。
loki.source.docker "app" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.stable.output
  relabel_rules = discovery.relabel.app.rules
  forward_to    = [loki.write.local.receiver]
}

// 4. 推送给 Loki（Loki 只接收，不会主动来拉）
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
