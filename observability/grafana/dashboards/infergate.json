{
  "uid": "infergate-m3",
  "title": "InferGate 本地可观测性",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "infergate",
    "local"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求结果速率",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(infergate_requests_total{job=\"infergate\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "请求耗时 P95",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(infergate_request_duration_seconds_bucket{job=\"infergate\"}[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "后端尝试结果速率",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend, outcome) (rate(infergate_backend_attempts_total{job=\"infergate\"}[5m]))",
          "legendFormat": "{{backend}} / {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "尝试耗时 P95",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, backend, outcome) (rate(infergate_backend_attempt_duration_seconds_bucket{job=\"infergate\"}[5m])))",
          "legendFormat": "{{backend}} / {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "请求首字节 P95（含 fallback）",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(infergate_request_first_byte_seconds_bucket{job=\"infergate\"}[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "尝试首字节 P95",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, backend, outcome) (rate(infergate_backend_first_byte_seconds_bucket{job=\"infergate\"}[5m])))",
          "legendFormat": "{{backend}} / {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "当前占用并发名额",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "infergate_active_requests{job=\"infergate\"}",
          "legendFormat": "occupied slots"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "当前后端选路健康状态",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "infergate_backend_healthy{job=\"infergate\"}",
          "legendFormat": "{{backend}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "拒绝原因速率",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(infergate_requests_total{job=\"infergate\",outcome=\"rejected\"}[5m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "网关抓取状态",
      "datasource": {
        "type": "prometheus",
        "uid": "infergate-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"infergate\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "text",
      "title": "测量边界与追踪入口",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "当前没有等待队列；不测量 TTFT 或 token/s。首字节是读取到首个非空 body chunk，空白字节也计入。\n\n没有样本时保持 No data，不伪造为 0。低流量下分位数仅供观测，不能当作性能验收结论。\n\n请求/尝试指标等请求定稿后提交；并发和健康 Gauge 是抓取时的状态。\n\n[打开 Jaeger](http://127.0.0.1:16686)；用完成日志的 trace_id 搜索请求，查看 fallback 和流式关闭。"
      }
    }
  ]
}
